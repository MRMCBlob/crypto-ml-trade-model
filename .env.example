# Crypto ML Trading System - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# API KEYS & WEBHOOKS
# =============================================================================

# CoinGecko API Key (optional - free tier works without, but has lower rate limits)
# Get one at: https://www.coingecko.com/en/api/pricing (Demo tier is free)
COINGECKO_API_KEY=

# Discord Webhook URL for trade notifications and 12-hour reports
# Create a webhook: Discord Server Settings > Integrations > Webhooks > New Webhook
# Example: https://discord.com/api/webhooks/1234567890/abcdefghijklmnop
DISCORD_WEBHOOK_URL=

# =============================================================================
# DATABASE
# =============================================================================

# SQLite database path (relative to project root)
# Note: Uses 'storage/' to avoid conflict with Python 'data/' module
DATABASE_PATH=storage/trading.db

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================

# Trading mode: paper or live (only paper is implemented)
TRADING_MODE=paper

# Initial capital for paper trading (USD)
INITIAL_CAPITAL=10000

# Maximum position size as percentage of portfolio (0.0 - 1.0)
MAX_POSITION_PCT=0.20

# Maximum total exposure as percentage of portfolio (0.0 - 1.0)
MAX_TOTAL_EXPOSURE=0.80

# Risk per trade as percentage of portfolio (0.0 - 1.0)
RISK_PER_TRADE_PCT=0.02

# Maximum drawdown before trading halt (0.0 - 1.0)
MAX_DRAWDOWN_PCT=0.15

# Maximum daily loss before trading halt (0.0 - 1.0)
MAX_DAILY_LOSS_PCT=0.05

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Prediction horizon in days (for swing trading)
PREDICTION_HORIZON=7

# LSTM sequence length (lookback period in days)
SEQUENCE_LENGTH=30

# Training/validation split ratio
VALIDATION_SPLIT=0.2

# =============================================================================
# CATEGORY ALLOCATION OVERRIDES (optional)
# =============================================================================

# Maximum allocation per category (0.0 - 1.0)
# Uncomment and modify to override defaults
# MAX_ALLOCATION_LARGE_CAP=0.40
# MAX_ALLOCATION_ALTCOIN=0.30
# MAX_ALLOCATION_DEFI=0.15
# MAX_ALLOCATION_LAYER2=0.15
# MAX_ALLOCATION_MEMECOIN=0.10
# MAX_ALLOCATION_AI=0.10
# MAX_ALLOCATION_GAMING=0.10

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log directory (relative to project root)
LOG_DIR=logs

# =============================================================================
# DOCKER / COOLIFY SPECIFIC
# =============================================================================

# Timezone for scheduled tasks
TZ=UTC

# Force re-download data on container start (true/false)
FORCE_DATA_DOWNLOAD=false

# Force re-train models on container start (true/false)
FORCE_MODEL_TRAINING=false

# Python environment
PYTHONPATH=/app
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
